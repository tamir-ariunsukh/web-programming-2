# .gitignore — ХИЧЭЭЛИЙН БҮХ ДОЛОО ХОНОГИЙН root түвшний дүрэм.
#
# Энэ repo-д week3, week4, ..., week16 хавтаснууд зэрэгцэн байрлана.
# Доорх дүрмүүд нь БҮХ дэд хавтаст үйлчилнэ (gitignore нь рекурсвээр ажиллана),
# тиймээс долоо хоног бүрт давхарлан бичих шаардлагагүй.
#
# Жич: "!" тэмдгээр эхэлсэн мөр = үл хамаарах (дахин git-д оруулна).

# ─────────────── Хамаарал (dependencies) ───────────────
# Аль ч долоо хоногийн node_modules — "npm install"-аар сэргээгдэнэ.
node_modules/

# Python хичээлүүдийн виртуал орчин (байвал) — локал хэрэгсэл.
.venv/
venv/
__pycache__/

# ─────────────── Бүтээлт (build output) ───────────────
dist/
dist-ssr/
build/
.vite/

# ─────────────── Лог ───────────────
*.log
logs/

# ─────────────── Орчны хувьсагч (СУУРЬ ХАМГААЛАЛТ!) ───────────────
# .env дотор API key, token байж болно — repo руу ХЭЗЭЭ Ч битгий оруул.
.env
.env.local
.env.*.local
*.local

# ─────────────── Хичээлийн материал (PDF) ───────────────
# Лекц, унших материалын PDF-үүд хөтөч дээр хадгалагддаг тул repo-д оруулахгүй.
# (Хэрэв нэг PDF-ийг оруулах бол: !унших_материал.pdf гэж үл хамаарлын дүрэм нэмнэ.)
*.pdf

# ─────────────── context-mode (AI хэрэгслийн локал өгөгдөл) ───────────────
# Сессийн лог, индексийг энд хадгалдаг — зөвхөн локал машин дээр хэрэгтэй.
.context-mode/

# ─────────────── Засварлагч ба OS ───────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# ─────────────── Кэш ───────────────
.cache/
.eslintcache
*.tsbuildinfo

# ─────────────── Түр файлууд ───────────────
*.tmp
*.bak
~$*
